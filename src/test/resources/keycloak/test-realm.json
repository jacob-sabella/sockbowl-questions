{
  "realm": "test",
  "enabled": true,
  "sslRequired": "none",
  "bruteForceProtected": false,
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "packet:read", "description": "Reserved (D2): reads are governed by visibility, not this role" },
      { "name": "packet:create" },
      { "name": "packet:update" },
      { "name": "packet:delete" },
      { "name": "question:generate" },
      { "name": "taxonomy:manage" },
      { "name": "game:host" },
      { "name": "user:ban" },
      { "name": "admin:access" },
      { "name": "packet:manage-any" },
      { "name": "packet:read-answers", "description": "Game service account only (D2)" },
      {
        "name": "player",
        "composite": true,
        "composites": { "realm": ["packet:read", "game:host"] }
      },
      {
        "name": "author",
        "composite": true,
        "composites": {
          "realm": ["player", "packet:create", "packet:update", "packet:delete", "question:generate", "taxonomy:manage"]
        }
      },
      {
        "name": "moderator",
        "composite": true,
        "composites": { "realm": ["player", "user:ban"] }
      },
      {
        "name": "admin",
        "composite": true,
        "composites": { "realm": ["author", "moderator", "packet:delete", "admin:access", "packet:manage-any"] }
      },
      {
        "name": "user",
        "composite": true,
        "composites": { "realm": ["player"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "sockbowl-e2e",
      "name": "Sockbowl E2E (test)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "sockbowl-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sockbowl-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sockbowl-game-backend",
      "name": "Sockbowl Game Backend (test)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "test-backend-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "sockbowl-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sockbowl-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sockbowl-no-audience",
      "name": "Client without the sockbowl-api-audience mapper (test only)",
      "description": "AudienceIT: mints tokens missing aud=sockbowl-api so the decoder must reject them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "player",
      "enabled": true,
      "email": "player@sockbowl-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Player",
      "realmRoles": ["player"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "author",
      "enabled": true,
      "email": "author@sockbowl-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Author",
      "realmRoles": ["author"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "author2",
      "enabled": true,
      "email": "author2@sockbowl-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "AuthorTwo",
      "realmRoles": ["author"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "moderator",
      "enabled": true,
      "email": "moderator@sockbowl-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Moderator",
      "realmRoles": ["moderator"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "admin",
      "enabled": true,
      "email": "admin@sockbowl-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "realmRoles": ["admin"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "username": "service-account-sockbowl-game-backend",
      "enabled": true,
      "serviceAccountClientId": "sockbowl-game-backend",
      "realmRoles": ["packet:read", "packet:read-answers"]
    }
  ]
}
