# src/main/resources/graphql/schema.graphqls

type Query {
  getAllPackets: [Packet!]! @deprecated(reason: "use packets")
  getPacketById(id: ID!): Packet
  searchPacketsByName(name: String!): [Packet!]!

  getAllDifficulties: [Difficulty!]!
  getAllCategories: [Category!]!
  getAllSubcategories: [Subcategory!]!
}

"""
Authoring mutations backing the packet-builder UI. All mutations that affect a
packet's contents return the affected Packet so the client can refresh; node-level
edits return the affected node. Relationship order is kept dense and zero-based.

Every mutation that targets an existing packet or its content takes an optional
expectedVersion: the Packet.version the client last saw. A stale value is rejected
with the CONFLICT classification; omitting it skips the check (M3, PB-18).
"""
type Mutation {
  # --- Packet ---
  createPacket(input: CreatePacketInput!): Packet!
  renamePacket(id: ID!, name: String!, expectedVersion: Int): Packet!
  setPacketDifficulty(id: ID!, difficultyId: ID!, expectedVersion: Int): Packet!
  deletePacket(id: ID!, expectedVersion: Int): Boolean!
  """Publish or unpublish a packet. Requires packet:update and ownership (or packet:manage-any)."""
  setPacketVisibility(id: ID!, visibility: PacketVisibility!, expectedVersion: Int): Packet!

  # --- Tossups (order is optional; null/oversized appends) ---
  addTossupToPacket(packetId: ID!, input: TossupInput!, order: Int, expectedVersion: Int): Packet!
  updateTossup(id: ID!, input: TossupInput!, expectedVersion: Int): Tossup!
  removeTossupFromPacket(packetId: ID!, tossupId: ID!, expectedVersion: Int): Packet!
  reorderTossup(packetId: ID!, tossupId: ID!, newOrder: Int!, expectedVersion: Int): Packet!

  # --- Bonuses ---
  addBonusToPacket(packetId: ID!, input: BonusInput!, order: Int, expectedVersion: Int): Packet!
  updateBonus(id: ID!, input: BonusUpdateInput!, expectedVersion: Int): Bonus!
  removeBonusFromPacket(packetId: ID!, bonusId: ID!, expectedVersion: Int): Packet!
  reorderBonus(packetId: ID!, bonusId: ID!, newOrder: Int!, expectedVersion: Int): Packet!

  # --- Bonus parts ---
  addBonusPart(bonusId: ID!, input: BonusPartInput!, order: Int, expectedVersion: Int): Bonus!
  updateBonusPart(bonusId: ID!, bonusPartId: ID!, input: BonusPartInput!, expectedVersion: Int): Bonus!
  removeBonusPart(bonusId: ID!, bonusPartId: ID!, expectedVersion: Int): Bonus!
  reorderBonusPart(bonusId: ID!, bonusPartId: ID!, newOrder: Int!, expectedVersion: Int): Bonus!

  # --- Taxonomy (TaxonomyController; taxonomy:manage, D4) ---
  createDifficulty(name: String!): Difficulty!
  createCategory(name: String!): Category!
  createSubcategory(name: String!, categoryId: ID!): Subcategory!
  # --- Subcategory assignment (null subcategoryId clears it, PB-09) ---
  setTossupSubcategory(tossupId: ID!, subcategoryId: ID, expectedVersion: Int): Tossup!
  setBonusSubcategory(bonusId: ID!, subcategoryId: ID, expectedVersion: Int): Bonus!

  # --- AI assist (reuses the existing generation service) ---
  generateAndAddTossup(packetId: ID!, input: GenerateTossupInput!, order: Int, expectedVersion: Int): Packet!
}

"""Input for creating a packet. difficultyId is optional at creation time."""
input CreatePacketInput {
  name: String!
  difficultyId: ID
}

"""Input for creating or updating a tossup. subcategoryId is optional."""
input TossupInput {
  question: String!
  answer: String!
  subcategoryId: ID
}

"""Input for creating a bonus, optionally with its initial parts in order."""
input BonusInput {
  preamble: String
  subcategoryId: ID
  parts: [BonusPartInput!]
}

"""Input for updating a bonus node's own fields (parts use the dedicated mutations)."""
input BonusUpdateInput {
  preamble: String
  subcategoryId: ID
}

"""Input for a single bonus part (question/answer pair)."""
input BonusPartInput {
  question: String!
  answer: String!
}

"""
Input for AI-assisted tossup generation. apiKey/model mirror the X-API-Key /
X-Model headers used by the REST generation endpoint and obey the same security
rules.
"""
input GenerateTossupInput {
  topic: String!
  additionalContext: String
  subcategoryId: ID
  apiKey: String
  model: String
}


"""
Event Node
"""
type Event {
  id: ID!
  location: String
  name: String
  year: Int
  imported: Boolean
  packets: [UsesPacketAtRound]
}

"""
Relationship from Event -> Packet
"""
type UsesPacketAtRound {
  id: ID!
  round: Int
  packet: Packet
}

"""
Who may read a packet. DRAFT: only the owner, packet:manage-any and the game
service. PUBLISHED: everyone; callers without full-read rights get the packet
with answers removed. Packets created before visibility existed read as PUBLISHED.
EPHEMERAL: a game-only bank packet generated by a guest or player (D15); never
listed or searched, never editable, readable only by the game service, and
deleted after sockbowl.packet.ephemeral-ttl. It can't be set through
setPacketVisibility.
"""
enum PacketVisibility {
  DRAFT
  PUBLISHED
  EPHEMERAL
}

"""
Packet Node
"""
type Packet {
  id: ID!
  name: String
  difficulty: Difficulty
  tossups: [ContainsTossup]
  bonuses: [ContainsBonus]
  owner: PacketOwner
  visibility: PacketVisibility!
  """True when answers were removed because the caller may not read them."""
  answersRedacted: Boolean!
}

"""
Read-only view of a packet's creator. Null for anonymous/legacy packets
(guest-generated, or created before ownership tracking existed).
"""
type PacketOwner {
  id: String
  name: String
}

"""
Difficulty Node
"""
type Difficulty {
  id: ID!
  name: String
}

"""
Relationship from Packet -> Tossup
"""
type ContainsTossup {
  id: ID!
  order: Int
  tossup: Tossup
}

"""
Tossup Node
"""
type Tossup {
  id: ID!
  question: String
  answer: String
  subcategory: Subcategory
}

"""
Subcategory Node
"""
type Subcategory {
  id: ID!
  name: String
  category: Category
}

"""
Category Node
"""
type Category {
  id: ID!
  name: String
}

"""
Relationship from Packet -> Bonus
"""
type ContainsBonus {
  id: ID!
  order: Int
  bonus: Bonus
}

"""
Bonus Node
"""
type Bonus {
  id: ID!
  preamble: String
  subcategory: Subcategory
  bonusParts: [HasBonusPart]
}

"""
Relationship from Bonus -> BonusPart
"""
type HasBonusPart {
  id: ID!
  order: Int
  bonusPart: BonusPart
}

"""
BonusPart Node
"""
type BonusPart {
  id: ID!
  question: String
  answer: String
}

# --- M3 ---
# Packet builder additions (plans/m3-packets.md 3.1.11). Kept in one delimited block so
# the parallel M4 branch (# --- M4 ---) merges textually. Changes to existing
# declarations (expectedVersion args, nullable set*Subcategory ids, the getAllPackets
# deprecation) are made in place above. Fields marked TODO(Qn) have no data fetcher yet
# and are wired by that work package; schema inspection lists them as unmapped.

extend type Query {
  """
  Paginated, answer-free packet summaries, filtered by the caller's read rights (D2).
  size is capped at 100. TODO(Q5)
  """
  packets(filter: PacketFilter, page: Int = 0, size: Int = 25): PacketPage!
  """Plaintext export (D5). Needs full read of the packet."""
  exportPacket(id: ID!, format: PacketExportFormat = PLAINTEXT): String!
}

extend type Mutation {
  """Parse a plaintext packet (D5); dryRun (the default) previews without writing."""
  importPacket(input: ImportPacketInput!): ImportPacketResult!
  """Copy a packet the caller may read in full into a new DRAFT they own."""
  clonePacket(id: ID!, name: String): Packet!
  """Taxonomy rename/merge, taxonomy:manage only (D4)."""
  renameCategory(id: ID!, name: String!): Category!
  renameSubcategory(id: ID!, name: String!): Subcategory!
  renameDifficulty(id: ID!, name: String!): Difficulty!
  mergeCategories(sourceId: ID!, targetId: ID!): Category!
  mergeSubcategories(sourceId: ID!, targetId: ID!): Subcategory!
  mergeDifficulties(sourceId: ID!, targetId: ID!): Difficulty!
}

extend type Packet {
  """Optimistic-lock version; send it back as expectedVersion. Null in storage reads as 0."""
  version: Int!
  """Playability and D7 warnings for this packet. playable is true exactly when no issue is an ERROR."""
  validation: PacketValidation!
}

input PacketFilter {
  mine: Boolean
  nameContains: String
  difficultyId: ID
  visibility: PacketVisibility
  playableOnly: Boolean
}

type PacketPage {
  items: [PacketSummary!]!
  total: Int!
  page: Int!
  size: Int!
}

type PacketSummary {
  id: ID!
  name: String
  difficulty: Difficulty
  owner: PacketOwner
  visibility: PacketVisibility!
  version: Int!
  tossupCount: Int!
  bonusCount: Int!
  playable: Boolean!
}

type PacketValidation {
  playable: Boolean!
  tossupCount: Int!
  bonusCount: Int!
  issues: [ValidationIssue!]!
}

type ValidationIssue {
  severity: IssueSeverity!
  code: String!
  message: String!
  tossupId: ID
  bonusId: ID
}

enum IssueSeverity {
  ERROR
  WARNING
  INFO
}

enum PacketExportFormat {
  PLAINTEXT
}

input ImportPacketInput {
  text: String!
  name: String
  difficultyId: ID
  dryRun: Boolean = true
  skipInvalid: Boolean = false
}

type ImportPacketResult {
  committed: Boolean!
  packet: Packet
  parsed: ParsedPacket!
  issues: [ImportIssue!]!
}

type ParsedPacket {
  suggestedName: String
  tossups: [ParsedTossup!]!
  bonuses: [ParsedBonus!]!
}

type ParsedTossup {
  number: Int
  line: Int!
  question: String!
  answer: String!
  categoryTag: String
  subcategory: Subcategory
}

type ParsedBonus {
  number: Int
  line: Int!
  preamble: String
  parts: [ParsedBonusPart!]!
  categoryTag: String
  subcategory: Subcategory
}

type ParsedBonusPart {
  line: Int!
  question: String!
  answer: String!
}

type ImportIssue {
  severity: IssueSeverity!
  line: Int
  message: String!
}
