{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "Bonus" : {
      "type" : "object",
      "properties" : {
        "aiModel" : {
          "type" : "string"
        },
        "bonusParts" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/HasBonusPart"
          }
        },
        "createdAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "createdBy" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string"
        },
        "lastModifiedAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "lastModifiedBy" : {
          "type" : "string"
        },
        "preamble" : {
          "type" : "string"
        },
        "remoteId" : {
          "type" : "string"
        },
        "source" : {
          "$ref" : "#/$defs/ContentSource"
        },
        "subcategory" : {
          "$ref" : "#/$defs/Subcategory"
        }
      }
    },
    "BonusPart" : {
      "type" : "object",
      "properties" : {
        "aiModel" : {
          "type" : "string"
        },
        "answer" : {
          "type" : "string"
        },
        "createdAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "createdBy" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string"
        },
        "lastModifiedAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "lastModifiedBy" : {
          "type" : "string"
        },
        "question" : {
          "type" : "string"
        },
        "source" : {
          "$ref" : "#/$defs/ContentSource"
        }
      }
    },
    "Category" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "name" : {
          "type" : "string"
        }
      }
    },
    "ContainsBonus" : {
      "type" : "object",
      "properties" : {
        "bonus" : {
          "$ref" : "#/$defs/Bonus"
        },
        "id" : {
          "type" : "integer"
        },
        "order" : {
          "type" : "integer"
        }
      }
    },
    "ContainsTossup" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "integer"
        },
        "order" : {
          "type" : "integer"
        },
        "tossup" : {
          "$ref" : "#/$defs/Tossup"
        }
      }
    },
    "ContentSource" : {
      "type" : "string",
      "enum" : [ "AUTHORED", "QBREADER_IMPORT", "AI_GENERATED", "TEXT_IMPORT", "CLONED" ]
    },
    "Difficulty" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "name" : {
          "type" : "string"
        }
      }
    },
    "HasBonusPart" : {
      "type" : "object",
      "properties" : {
        "bonusPart" : {
          "$ref" : "#/$defs/BonusPart"
        },
        "id" : {
          "type" : "integer"
        },
        "order" : {
          "type" : "integer"
        }
      }
    },
    "PacketVisibility" : {
      "type" : "string",
      "enum" : [ "DRAFT", "PUBLISHED", "EPHEMERAL" ]
    },
    "Subcategory" : {
      "type" : "object",
      "properties" : {
        "category" : {
          "$ref" : "#/$defs/Category"
        },
        "id" : {
          "type" : "string"
        },
        "name" : {
          "type" : "string"
        }
      }
    },
    "Tossup" : {
      "type" : "object",
      "properties" : {
        "aiModel" : {
          "type" : "string"
        },
        "answer" : {
          "type" : "string"
        },
        "createdAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "createdBy" : {
          "type" : "string"
        },
        "id" : {
          "type" : "string"
        },
        "lastModifiedAt" : {
          "type" : "string",
          "format" : "date-time"
        },
        "lastModifiedBy" : {
          "type" : "string"
        },
        "question" : {
          "type" : "string"
        },
        "remoteId" : {
          "type" : "string"
        },
        "source" : {
          "$ref" : "#/$defs/ContentSource"
        },
        "subcategory" : {
          "$ref" : "#/$defs/Subcategory"
        }
      }
    }
  },
  "type" : "object",
  "properties" : {
    "aiModel" : {
      "type" : "string"
    },
    "answersRedacted" : {
      "type" : "boolean"
    },
    "bonuses" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/ContainsBonus"
      }
    },
    "createdAt" : {
      "type" : "string",
      "format" : "date-time"
    },
    "createdBy" : {
      "type" : "string"
    },
    "difficulty" : {
      "$ref" : "#/$defs/Difficulty"
    },
    "id" : {
      "type" : "string"
    },
    "lastModifiedAt" : {
      "type" : "string",
      "format" : "date-time"
    },
    "lastModifiedBy" : {
      "type" : "string"
    },
    "name" : {
      "type" : "string"
    },
    "ownerDisplayName" : {
      "type" : "string"
    },
    "ownerId" : {
      "type" : "string"
    },
    "source" : {
      "$ref" : "#/$defs/ContentSource"
    },
    "tossups" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/ContainsTossup"
      }
    },
    "visibility" : {
      "$ref" : "#/$defs/PacketVisibility"
    }
  },
  "title" : "Packet"
}